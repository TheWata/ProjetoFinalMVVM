<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- CORES BÁSICAS .NET MAUI -->
    <Color x:Key="Primary">#16A34A</Color>
    <Color x:Key="PrimaryDark">#15803D</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#6366F1</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#0EA5E9</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- PALETA SEMÂNTICA MODO CLARO (PADRÃO AMIGÁVEL) -->
    <Color x:Key="AppPageBg">#F8FAFC</Color>
    <Color x:Key="AppCardBg">#FFFFFF</Color>
    <Color x:Key="AppCardBorder">#E2E8F0</Color>
    <Color x:Key="AppTextPrimary">#0F172A</Color>
    <Color x:Key="AppTextSecondary">#64748B</Color>
    <Color x:Key="AppTextMuted">#94A3B8</Color>

    <Color x:Key="AppInputBg">#F8FAFC</Color>
    <Color x:Key="AppInputBorder">#CBD5E1</Color>

    <Color x:Key="AppBadgeSuccessBg">#DCFCE7</Color>
    <Color x:Key="AppBadgeSuccessText">#15803D</Color>
    <Color x:Key="AppBadgeWarningBg">#FEF3C7</Color>
    <Color x:Key="AppBadgeWarningText">#B45309</Color>
    <Color x:Key="AppBadgeInfoBg">#E0F2FE</Color>
    <Color x:Key="AppBadgeInfoText">#0369A1</Color>
    <Color x:Key="AppBadgePurpleBg">#F3E8FF</Color>
    <Color x:Key="AppBadgePurpleText">#7E22CE</Color>

    <!-- BRUSHES -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>