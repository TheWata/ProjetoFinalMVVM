<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjetoFinalMVVM.ViewModels"
             xmlns:models="clr-namespace:ProjetoFinalMVVM.Models"
             x:Class="ProjetoFinalMVVM.Views.AdminMainView"
             x:DataType="vm:ItemViewModel"
             Title="Painel do Administrador Geral"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="12">

        <!-- 1. TOPO / CABEÇALHO DO ADMINISTRADOR -->
        <Border Grid.Row="0"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF"
                StrokeShape="RoundRectangle 16"
                Padding="16,12">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="&#xf521;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="15"
                               TextColor="#EAB308"
                               VerticalOptions="Center" />
                        <Label Text="Administrador:"
                               FontSize="14"
                               TextColor="#64748B"
                               VerticalOptions="Center" />
                        <Label Text="{Binding NomeUsuarioLogado}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Gestão Global: Clientes, Locadoras e Catálogo de Consoles"
                           FontSize="11"
                           TextColor="#94A3B8" />
                </VerticalStackLayout>

                <!-- Botão Histórico Geral -->
                <Button Grid.Column="1"
                        Text="Histórico"
                        Command="{Binding IrParaHistoricoCommand}"
                        BackgroundColor="#F0F9FF"
                        TextColor="#0284C7"
                        BorderColor="#BAE6FD"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="11"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="10,0" />

                <!-- Botão Configurações da Conta -->
                <Button Grid.Column="2"
                        Text="Ajustes"
                        Command="{Binding IrParaConfiguracoesCommand}"
                        BackgroundColor="#F8FAFC"
                        TextColor="#475569"
                        BorderColor="#CBD5E1"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="11"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="10,0" />

                <!-- Botão Sair -->
                <Button Grid.Column="3"
                        Text="Sair"
                        Command="{Binding DeslogarCommand}"
                        BackgroundColor="#FEE2E2"
                        TextColor="#DC2626"
                        BorderColor="#FCA5A5"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="11"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="10,0" />
            </Grid>
        </Border>

        <!-- 2. BARRA DE ABAS DO ADMINISTRADOR (4 MÓDULOS DE GESTÃO) -->
        <Border Grid.Row="1"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                BackgroundColor="#F1F5F9"
                StrokeShape="RoundRectangle 12"
                Padding="4">
            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6">

                <!-- ABA 1: DASHBOARD -->
                <Button Grid.Column="0"
                        Text="Dashboard"
                        Command="{Binding TrocarAbaAdminCommand}"
                        CommandParameter="Dashboard"
                        BackgroundColor="{Binding CorBotaoAdminDashboard}"
                        TextColor="{Binding CorTextoAdminDashboard}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="8"
                        HeightRequest="38" />

                <!-- ABA 2: CONSOLES -->
                <Button Grid.Column="1"
                        Text="Consoles"
                        Command="{Binding TrocarAbaAdminCommand}"
                        CommandParameter="Consoles"
                        BackgroundColor="{Binding CorBotaoAdminConsoles}"
                        TextColor="{Binding CorTextoAdminConsoles}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="8"
                        HeightRequest="38" />

                <!-- ABA 3: LOCADORAS -->
                <Button Grid.Column="2"
                        Text="Locadoras"
                        Command="{Binding TrocarAbaAdminCommand}"
                        CommandParameter="Locadoras"
                        BackgroundColor="{Binding CorBotaoAdminLocadoras}"
                        TextColor="{Binding CorTextoAdminLocadoras}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="8"
                        HeightRequest="38" />

                <!-- ABA 4: USUÁRIOS -->
                <Button Grid.Column="3"
                        Text="Usuários"
                        Command="{Binding TrocarAbaAdminCommand}"
                        CommandParameter="Usuarios"
                        BackgroundColor="{Binding CorBotaoAdminUsuarios}"
                        TextColor="{Binding CorTextoAdminUsuarios}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="8"
                        HeightRequest="38" />
            </Grid>
        </Border>

        <!-- 3. CONTEÚDO DAS 4 ABAS -->
        <Grid Grid.Row="2">

            <!-- ============================================== -->
            <!-- ABA 1: DASHBOARD & CALENDÁRIO                  -->
            <!-- ============================================== -->
            <ScrollView IsVisible="{Binding IsAbaAdminDashboardAtiva}">
                <VerticalStackLayout Spacing="16">

                    <!-- Dashboard Financeiro Geral -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xf201;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="16"
                                   TextColor="#16A34A"
                                   VerticalOptions="Center" />
                            <Label Text="Métricas Financeiras &amp; Rede"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                        </HorizontalStackLayout>

                        <!-- Grid de Cards do Dashboard -->
                        <Grid ColumnDefinitions="*, *"
                              RowDefinitions="Auto, Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">

                            <!-- Card Receita Total -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Stroke="#86EFAC"
                                    StrokeThickness="1"
                                    BackgroundColor="#F0FDF4"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#xf155;"
                                               FontFamily="FontAwesomeSolid"
                                               FontSize="11"
                                               TextColor="#15803D"
                                               VerticalOptions="Center" />
                                        <Label Text="RECEITA TOTAL"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#15803D" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding ReceitaTotalFormatada}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="{Binding TotalLocacoesCount, StringFormat='{0} locações efetuadas'}"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card Receita Extras -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Stroke="#D8B4FE"
                                    StrokeThickness="1"
                                    BackgroundColor="#FAF5FF"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#xf02b;"
                                               FontFamily="FontAwesomeSolid"
                                               FontSize="11"
                                               TextColor="#7E22CE"
                                               VerticalOptions="Center" />
                                        <Label Text="TAXAS &amp; EXTRAS"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#7E22CE" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding ReceitaExtrasFormatada}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="Controles extras e multas"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card Ticket Médio -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Stroke="#BAE6FD"
                                    StrokeThickness="1"
                                    BackgroundColor="#F0F9FF"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#xf201;"
                                               FontFamily="FontAwesomeSolid"
                                               FontSize="11"
                                               TextColor="#0284C7"
                                               VerticalOptions="Center" />
                                        <Label Text="TICKET MÉDIO"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#0284C7" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding TicketMedioFormatado}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="Média por locação"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card Status Consoles -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Stroke="#FDE68A"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFBEB"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#xf468;"
                                               FontFamily="FontAwesomeSolid"
                                               FontSize="11"
                                               TextColor="#B45309"
                                               VerticalOptions="Center" />
                                        <Label Text="ESTOQUE REDE"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#B45309" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding ConsolesAlugadosCount, StringFormat='{0} Alugados'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#DC2626" />
                                        <Label Text="|" TextColor="#CBD5E1" />
                                        <Label Text="{Binding ConsolesDisponiveisCount, StringFormat='{0} Livres'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#16A34A" />
                                    </HorizontalStackLayout>
                                    <Label Text="Total geral cadastrado"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Calendário Interativo de Devoluções (14 Dias) -->
                    <Border Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xf133;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="16"
                                       TextColor="#16A34A"
                                       VerticalOptions="Center" />
                                <Label Text="Devoluções Previstas (14 Dias)"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>

                            <!-- Carrossel / Lista Horizontal de Dias -->
                            <CollectionView ItemsSource="{Binding DiasCalendario}"
                                            SelectedItem="{Binding SelecionadoDia, Mode=TwoWay}"
                                            SelectionMode="Single"
                                            HeightRequest="94">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiaCalendario">
                                        <Border Stroke="{Binding CorBordaCard}"
                                                StrokeThickness="1.5"
                                                BackgroundColor="{Binding CorFundoCard}"
                                                StrokeShape="RoundRectangle 12"
                                                WidthRequest="66"
                                                HeightRequest="88"
                                                Padding="4">
                                            <VerticalStackLayout Spacing="2"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding DiaSemana}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#64748B"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding DiaNumero}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A"
                                                       HorizontalTextAlignment="Center" />
                                                <Border BackgroundColor="{Binding CorBadgeFundo}"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="4,1"
                                                        HorizontalOptions="Center"
                                                        IsVisible="{Binding TemDevolucoes}">
                                                    <Label Text="{Binding QuantidadeDevolucoes, StringFormat='{0} dev.'}"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding CorTextoBadge}" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <Label Text="Retornos agendados para a data selecionada:"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <!-- Lista de Devoluções do Dia Selecionado -->
                            <CollectionView ItemsSource="{Binding DevolucoesDoDia}">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Spacing="4" Padding="14" HorizontalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                            <Label Text="&#xf00c;"
                                                   FontFamily="FontAwesomeSolid"
                                                   FontSize="13"
                                                   TextColor="#16A34A"
                                                   VerticalOptions="Center" />
                                            <Label Text="Nenhum console pendente para devolução neste dia."
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#16A34A" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Historico">
                                        <Border Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                BackgroundColor="#F8FAFC"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="12"
                                                Margin="0,4">
                                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="&#xf007;"
                                                               FontFamily="FontAwesomeSolid"
                                                               FontSize="11"
                                                               TextColor="#64748B"
                                                               VerticalOptions="Center" />
                                                        <Label Text="{Binding UsuarioNome}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="#0F172A" />
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding ItemNome, StringFormat='Console: {0}'}"
                                                           FontSize="12"
                                                           TextColor="#334155" />
                                                    <Label Text="{Binding ChaveSerialConsole, StringFormat='Serial: {0}'}"
                                                           FontSize="11"
                                                           TextColor="#64748B" />
                                                    <Label Text="{Binding LocadoraNome, StringFormat='Unidade: {0}'}"
                                                           FontSize="11"
                                                           TextColor="#64748B" />
                                                    <Label Text="{Binding ValorTotalFormatado, StringFormat='Total: {0}'}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#16A34A" />
                                                </VerticalStackLayout>

                                                <Button Grid.Column="1"
                                                        Text="Receber Console"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ReceberConsoleCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#16A34A"
                                                        TextColor="#FFFFFF"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="36"
                                                        Padding="10,0"
                                                        VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ============================================== -->
            <!-- ABA 2: CONSOLES                                -->
            <!-- ============================================== -->
            <ScrollView IsVisible="{Binding IsAbaAdminConsolesAtiva}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="&#xf468;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="16"
                                   TextColor="#16A34A"
                                   VerticalOptions="Center" />
                            <Label Text="Catálogo Geral de Consoles"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="{Binding Itens.Count, StringFormat='({0})'}"
                                   FontSize="14"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Botão Novo Console -->
                        <Button Grid.Column="1"
                                Text="+ Novo Console"
                                Command="{Binding IrParaNovoConsoleCommand}"
                                BackgroundColor="#16A34A"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="12,0" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Itens}">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum console cadastrado ainda."
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   Margin="20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Item">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                        <!-- Imagem do Console -->
                                        <Border Grid.Column="0"
                                                WidthRequest="70"
                                                HeightRequest="70"
                                                Stroke="#CBD5E1"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#F8FAFC">
                                            <Image Source="{Binding ImgDiretorio}"
                                                   Aspect="AspectFill" />
                                        </Border>

                                        <!-- Dados do Console -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Nome}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A" />
                                                <Border BackgroundColor="{Binding StatusBadgeBg}"
                                                        StrokeShape="RoundRectangle 4"
                                                        Padding="6,1"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Status}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding StatusBadgeText}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding ChaveSerial, StringFormat='Serial: {0}'}"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                            <Label Text="{Binding LocadoraNome, StringFormat='Unidade: {0}'}"
                                                   FontSize="11"
                                                   TextColor="#94A3B8" />
                                            <Label Text="{Binding ValorDiariaFormatado}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#16A34A" />
                                        </VerticalStackLayout>

                                        <!-- Botões Editar e Excluir -->
                                        <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Button Text="Editar"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=EditarItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F0F9FF"
                                                    TextColor="#0284C7"
                                                    BorderColor="#BAE6FD"
                                                    BorderWidth="1"
                                                    FontSize="11"
                                                    HeightRequest="32"
                                                    Padding="10,0"
                                                    CornerRadius="6" />

                                            <Button Text="Excluir"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ExcluirItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2"
                                                    TextColor="#DC2626"
                                                    BorderColor="#FCA5A5"
                                                    BorderWidth="1"
                                                    FontSize="11"
                                                    HeightRequest="32"
                                                    Padding="10,0"
                                                    CornerRadius="6" />
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ============================================== -->
            <!-- ABA 3: LOCADORAS (FILIAIS DA REDE)             -->
            <!-- ============================================== -->
            <ScrollView IsVisible="{Binding IsAbaAdminLocadorasAtiva}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="&#xf54f;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="16"
                                   TextColor="#16A34A"
                                   VerticalOptions="Center" />
                            <Label Text="Filiais &amp; Locadoras da Rede"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="{Binding TodasLocadoras.Count, StringFormat='({0})'}"
                                   FontSize="14"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Botão Nova Filial -->
                        <Button Grid.Column="1"
                                Text="+ Nova Filial"
                                Command="{Binding IrParaNovaLocadoraCommand}"
                                BackgroundColor="#16A34A"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="12,0" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding TodasLocadoras}">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhuma filial cadastrada na rede."
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   Margin="20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Locadora">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">

                                        <!-- Informações da Filial -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Nome}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A" />

                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="&#xf3c5;"
                                                       FontFamily="FontAwesomeSolid"
                                                       FontSize="11"
                                                       TextColor="#94A3B8"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Endereco}"
                                                       FontSize="12"
                                                       TextColor="#64748B" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="&#xf095;"
                                                       FontFamily="FontAwesomeSolid"
                                                       FontSize="11"
                                                       TextColor="#16A34A"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Telefone}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#334155" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding CoordenadasTexto}"
                                                   FontSize="10"
                                                   TextColor="#94A3B8" />
                                        </VerticalStackLayout>

                                        <!-- Ações Administrativas (Editar e Excluir) -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Start">
                                            <Button Text="Editar"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=EditarLocadoraCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F0F9FF"
                                                    TextColor="#0284C7"
                                                    BorderColor="#BAE6FD"
                                                    BorderWidth="1"
                                                    FontSize="11"
                                                    HeightRequest="30"
                                                    Padding="10,0"
                                                    CornerRadius="6" />

                                            <Button Text="Excluir"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ExcluirLocadoraCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2"
                                                    TextColor="#DC2626"
                                                    BorderColor="#FCA5A5"
                                                    BorderWidth="1"
                                                    FontSize="11"
                                                    HeightRequest="30"
                                                    Padding="10,0"
                                                    CornerRadius="6" />
                                        </VerticalStackLayout>

                                        <!-- Ações de Integração (Mapas e Ligação) -->
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*, *" ColumnSpacing="8">
                                            <Button Grid.Column="0"
                                                    Text="Abrir no Mapa"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=AbrirRotaNoMapaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F1F5F9"
                                                    TextColor="#0369A1"
                                                    BorderColor="#BAE6FD"
                                                    BorderWidth="1"
                                                    FontAttributes="Bold"
                                                    FontSize="11"
                                                    HeightRequest="34"
                                                    CornerRadius="8" />

                                            <Button Grid.Column="1"
                                                    Text="Ligar para Filial"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=LigarLocadoraCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F0FDF4"
                                                    TextColor="#15803D"
                                                    BorderColor="#86EFAC"
                                                    BorderWidth="1"
                                                    FontAttributes="Bold"
                                                    FontSize="11"
                                                    HeightRequest="34"
                                                    CornerRadius="8" />
                                        </Grid>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ============================================== -->
            <!-- ABA 4: USUÁRIOS (CLIENTES, LOCADORAS, ADMINS)  -->
            <!-- ============================================== -->
            <ScrollView IsVisible="{Binding IsAbaAdminUsuariosAtiva}">
                <VerticalStackLayout Spacing="12">

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="&#xf0c0;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="16"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                        <Label Text="Usuários Registrados na Plataforma"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />
                        <Label Text="{Binding TodosUsuarios.Count, StringFormat='({0})'}"
                               FontSize="14"
                               TextColor="#64748B"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <CollectionView ItemsSource="{Binding TodosUsuarios}">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum usuário cadastrado."
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   Margin="20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Usuario">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                                        <!-- Informações do Usuário -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Nome}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A" />

                                                <!-- Badge do Perfil / Papel -->
                                                <Border BackgroundColor="{Binding TipoBadgeBg}"
                                                        StrokeShape="RoundRectangle 4"
                                                        Padding="6,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Tipo}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding TipoBadgeText}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding SubtituloDescricao}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#0369A1" />

                                            <Label Text="{Binding Email, StringFormat='Email: {0}'}"
                                                   FontSize="11"
                                                   TextColor="#64748B" />

                                            <Label Text="{Binding Cpf, StringFormat='CPF: {0}'}"
                                                   FontSize="11"
                                                   TextColor="#94A3B8" />
                                        </VerticalStackLayout>

                                        <!-- Botão Excluir Usuário -->
                                        <Button Grid.Column="1"
                                                Text="Excluir"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ExcluirUsuarioCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FEE2E2"
                                                TextColor="#DC2626"
                                                BorderColor="#FCA5A5"
                                                BorderWidth="1"
                                                FontSize="11"
                                                HeightRequest="32"
                                                Padding="12,0"
                                                CornerRadius="6"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
