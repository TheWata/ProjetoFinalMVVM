<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjetoFinalMVVM.ViewModels"
             xmlns:models="clr-namespace:ProjetoFinalMVVM.Models"
             x:Class="ProjetoFinalMVVM.Views.ClienteMainView"
             x:DataType="vm:ItemViewModel"
             Title="Game Rental Pro"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="14">

        <!-- 1. TOPO / CABEÇALHO DO CLIENTE -->
        <Border Grid.Row="0"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF"
                StrokeShape="RoundRectangle 16"
                Padding="16,12">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="&#xf11b;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="16"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                        <Label Text="Olá,"
                               FontSize="16"
                               TextColor="#64748B"
                               VerticalOptions="Center" />
                        <Label Text="{Binding NomeUsuarioLogado}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="&#xf124;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="10"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                        <Label Text="{Binding StatusGpsTexto}"
                               FontSize="10"
                               TextColor="#64748B"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Botão Atualizar GPS -->
                <Button Grid.Column="1"
                        Text="GPS"
                        Command="{Binding AtualizarGpsCommand}"
                        BackgroundColor="#F0FDF4"
                        TextColor="#16A34A"
                        BorderColor="#86EFAC"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="11"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="10,0" />

                <!-- Botão Histórico -->
                <Button Grid.Column="2"
                        Text="Histórico"
                        Command="{Binding IrParaHistoricoCommand}"
                        BackgroundColor="#F1F5F9"
                        TextColor="#0284C7"
                        BorderColor="#BAE6FD"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="11"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="10,0" />

                <!-- Botão Sair -->
                <Button Grid.Column="3"
                        Text="Sair"
                        Command="{Binding DeslogarCommand}"
                        BackgroundColor="#FEE2E2"
                        TextColor="#DC2626"
                        BorderColor="#FCA5A5"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="11"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="10,0" />
            </Grid>
        </Border>

        <!-- 2. SELETOR DE ABAS PRINCIPAIS (CONSOLES vs LOCADORAS) -->
        <Border Grid.Row="1"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                BackgroundColor="#F1F5F9"
                StrokeShape="RoundRectangle 12"
                Padding="4">
            <Grid ColumnDefinitions="*, *" ColumnSpacing="6">

                <!-- ABA 1: CONSOLES -->
                <Button Grid.Column="0"
                        Text="Consoles Disponíveis"
                        Command="{Binding TrocarAbaCommand}"
                        CommandParameter="Consoles"
                        BackgroundColor="{Binding CorBotaoAbaConsoles}"
                        TextColor="{Binding CorTextoAbaConsoles}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        HeightRequest="42" />

                <!-- ABA 2: LOCADORAS -->
                <Button Grid.Column="1"
                        Text="Nossas Locadoras"
                        Command="{Binding TrocarAbaCommand}"
                        CommandParameter="Locadoras"
                        BackgroundColor="{Binding CorBotaoAbaLocadoras}"
                        TextColor="{Binding CorTextoAbaLocadoras}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        HeightRequest="42" />
            </Grid>
        </Border>

        <!-- 3. CONTEÚDO DAS ABAS -->
        <Grid Grid.Row="2">

            <!-- ============================================== -->
            <!-- ABA 1: CONSOLES (ORDENADOS POR MAIS PRÓXIMO)  -->
            <!-- ============================================== -->
            <ScrollView IsVisible="{Binding IsAbaConsolesAtiva}">
                <VerticalStackLayout Spacing="12">

                    <!-- Banner Informativo / Filtro Ativo -->
                    <Border Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="&#xf3c5;"
                                           FontFamily="FontAwesomeSolid"
                                           FontSize="12"
                                           TextColor="#16A34A"
                                           VerticalOptions="Center" />
                                    <Label Text="Consoles Ordenados por Proximidade"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding TextoFiltroAtivo}"
                                       FontSize="11"
                                       TextColor="#16A34A"
                                       IsVisible="{Binding TemFiltroAtivo}" />
                                <Label Text="Mostrando modelos disponíveis nas filiais mais perto de você."
                                       FontSize="11"
                                       TextColor="#64748B"
                                       IsVisible="{Binding NaoTemFiltroAtivo}" />
                            </VerticalStackLayout>

                            <!-- Botão Limpar Filtro -->
                            <Button Grid.Column="1"
                                    Text="Ver Todos"
                                    Command="{Binding LimparFiltroLocadoraCommand}"
                                    IsVisible="{Binding TemFiltroAtivo}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#64748B"
                                    FontSize="11"
                                    CornerRadius="6"
                                    HeightRequest="30"
                                    Padding="10,0" />
                        </Grid>
                    </Border>

                    <!-- Grade de Consoles Disponíveis em 2 Colunas -->
                    <CollectionView ItemsSource="{Binding ConsolesDisponiveis}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="2"
                                             HorizontalItemSpacing="10"
                                             VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="24"
                                    Margin="0,10">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="&#xf468;"
                                           FontFamily="FontAwesomeSolid"
                                           FontSize="26"
                                           TextColor="#B45309"
                                           HorizontalOptions="Center" />
                                    <Label Text="Nenhum console disponível nesta unidade no momento."
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#B45309"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Selecione a aba 'Nossas Locadoras' para explorar outras unidades próximas."
                                           FontSize="11"
                                           TextColor="#64748B"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Item">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="10">
                                    <VerticalStackLayout Spacing="8">

                                        <!-- Imagem do Console -->
                                        <Border HeightRequest="110"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#F1F5F9">
                                            <Image Source="{Binding ImgDiretorio}"
                                                   Aspect="AspectFill" />
                                        </Border>

                                        <!-- Nome do Console -->
                                        <Label Text="{Binding Nome}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="TailTruncation" />

                                        <!-- Badge da Locadora com Distância em Km -->
                                        <Border BackgroundColor="#E0F2FE"
                                                Stroke="#BAE6FD"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="6,3">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding LocadoraNome}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#0369A1"
                                                       LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="&#xf3c5;"
                                                           FontFamily="FontAwesomeSolid"
                                                           FontSize="8"
                                                           TextColor="#0284C7"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding LocadoraDistanciaFormatada}"
                                                           FontSize="9"
                                                           TextColor="#0284C7" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Dados do Console -->
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding ChaveSerial, StringFormat='Serial: {0}'}"
                                                   FontSize="10"
                                                   TextColor="#94A3B8" />
                                            <Label Text="{Binding ContaVinculada, StringFormat='Conta: {0}'}"
                                                   FontSize="10"
                                                   TextColor="#64748B"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Desc}"
                                                   FontSize="10"
                                                   TextColor="#64748B"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <!-- Valores e Planos da Loja -->
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding ValorDiariaFormatado}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#16A34A" />
                                            <Label Text="{Binding PlanosDisponiveisTexto}"
                                                   FontSize="10"
                                                   TextColor="#0284C7"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <!-- Botão Alugar -->
                                        <Button Text="ALUGAR AGORA"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=AlugarConsoleCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#16A34A"
                                                TextColor="#FFFFFF"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                CornerRadius="8"
                                                HeightRequest="36" />

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ============================================== -->
            <!-- ABA 2: LOCADORAS (LEVA DIRETO AOS CONSOLES)   -->
            <!-- ============================================== -->
            <ScrollView IsVisible="{Binding IsAbaLocadorasAtiva}">
                <VerticalStackLayout Spacing="12">

                    <Border Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="&#xf3c5;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       TextColor="#16A34A"
                                       VerticalOptions="Center" />
                                <Label Text="Unidades e Filiais Físicas"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>
                            <Label Text="Escolha uma locadora para ver imediatamente os consoles disponíveis naquela unidade."
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Locadoras com Cards Grandes -->
                    <CollectionView ItemsSource="{Binding Locadoras}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Locadora">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="16"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">

                                        <!-- Informações da Unidade -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Nome}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A" />

                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="&#xf54f;"
                                                       FontFamily="FontAwesomeSolid"
                                                       FontSize="11"
                                                       TextColor="#94A3B8"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Endereco}"
                                                       FontSize="12"
                                                       TextColor="#64748B" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                                <!-- Badge Distância -->
                                                <Border BackgroundColor="#E0F2FE"
                                                        Stroke="#BAE6FD"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="8,2">
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Label Text="&#xf1b9;"
                                                               FontFamily="FontAwesomeSolid"
                                                               FontSize="10"
                                                               TextColor="#0369A1"
                                                               VerticalOptions="Center" />
                                                        <Label Text="{Binding DistanciaFormatada}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="#0369A1" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                                <!-- Badge Consoles Livres -->
                                                <Border BackgroundColor="#DCFCE7"
                                                        Stroke="#86EFAC"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="8,2">
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Label Text="&#xf11b;"
                                                               FontFamily="FontAwesomeSolid"
                                                               FontSize="10"
                                                               TextColor="#15803D"
                                                               VerticalOptions="Center" />
                                                        <Label Text="{Binding ConsolesDisponiveisFormatado}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="#15803D" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Botão Mais Informações -->
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Text="Info"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=VerDetalhesLocadoraCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F1F5F9"
                                                TextColor="#475569"
                                                FontSize="11"
                                                HeightRequest="34"
                                                CornerRadius="8"
                                                VerticalOptions="Start" />

                                        <!-- Ações de Mapa, Telefone e Seleção de Consoles -->
                                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                                <Button Grid.Column="0"
                                                        Text="Como Chegar"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=AbrirRotaNoMapaCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#F0F9FF"
                                                        TextColor="#0284C7"
                                                        BorderColor="#BAE6FD"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="36" />

                                                <Button Grid.Column="1"
                                                        Text="Ligar"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=LigarLocadoraCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#F0FDF4"
                                                        TextColor="#15803D"
                                                        BorderColor="#86EFAC"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="36" />
                                            </Grid>

                                            <Button Text="VER CONSOLES DESTA UNIDADE"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=VerConsolesDaLocadoraCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#16A34A"
                                                    TextColor="#FFFFFF"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    CornerRadius="8"
                                                    HeightRequest="40" />
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
