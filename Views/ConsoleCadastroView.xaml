<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjetoFinalMVVM.ViewModels"
             x:Class="ProjetoFinalMVVM.Views.ConsoleCadastroView"
             x:DataType="vm:ItemViewModel"
             Title="Cadastro de Console"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <Grid Padding="20"
              VerticalOptions="Center"
              MaximumWidthRequest="560"
              HorizontalOptions="Center">

            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 16"
                    Padding="24">

                <VerticalStackLayout Spacing="16">

                    <!-- Cabeçalho com Glyph FontAwesome -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                Stroke="#86EFAC"
                                StrokeThickness="1"
                                BackgroundColor="#DCFCE7"
                                StrokeShape="RoundRectangle 22">
                            <Label Text="&#xf11b;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="20"
                                   TextColor="#16A34A"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding TituloFormulario}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="Informe os dados técnicos e a filial de alocação do console."
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <!-- Campo Nome do Console -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xf11b;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <Label Text="Nome do Modelo"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </HorizontalStackLayout>
                        <Border Stroke="#CBD5E1"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,2">
                            <Entry Text="{Binding NomeConsole}"
                                   Placeholder="ex: Xbox 360, Nintendo Wii, Xbox One"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Grid Serial e Diária -->
                    <!-- Campo Chave Serial -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xf084;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <Label Text="Chave Serial"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </HorizontalStackLayout>
                        <Border Stroke="#CBD5E1"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,2">
                            <Entry Text="{Binding ChaveSerial}"
                                   Placeholder="ex: XB360-9842"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEÇÃO: OPÇÕES DE ALUGUEL DEFINIDAS PELA LOJA -->
                    <Border Stroke="#BAE6FD"
                            StrokeThickness="1"
                            BackgroundColor="#F0F9FF"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="&#xf155;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       TextColor="#0284C7"
                                       VerticalOptions="Center" />
                                <Label Text="Modalidades de Aluguel Disponíveis"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#0369A1" />
                            </HorizontalStackLayout>
                            <Label Text="Habilite as opções que a sua loja oferece para este modelo e defina o valor:"
                                   FontSize="11"
                                   TextColor="#0284C7" />

                            <!-- 1. Aluguel Diário -->
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*, Auto, 110" ColumnSpacing="10" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Aluguel Diário"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A" />
                                        <Label Text="Cobrado por dia avulso"
                                               FontSize="10"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1"
                                            IsToggled="{Binding PermiteDiaria}"
                                            OnColor="#16A34A"
                                            ThumbColor="#FFFFFF"
                                            VerticalOptions="Center" />
                                    <Border Grid.Column="2"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#F8FAFC"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,2"
                                            IsEnabled="{Binding PermiteDiaria}">
                                        <Entry Text="{Binding ValorDiaria}"
                                               Placeholder="35.00"
                                               TextColor="#0F172A"
                                               Keyboard="Numeric"
                                               FontSize="12"
                                               HorizontalTextAlignment="End" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 2. Aluguel Semanal -->
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*, Auto, 110" ColumnSpacing="10" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Aluguel Semanal"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A" />
                                        <Label Text="Pacote para 7 dias"
                                               FontSize="10"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1"
                                            IsToggled="{Binding PermiteSemanal}"
                                            OnColor="#16A34A"
                                            ThumbColor="#FFFFFF"
                                            VerticalOptions="Center" />
                                    <Border Grid.Column="2"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#F8FAFC"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,2"
                                            IsEnabled="{Binding PermiteSemanal}">
                                        <Entry Text="{Binding ValorSemanal}"
                                               Placeholder="180.00"
                                               TextColor="#0F172A"
                                               Keyboard="Numeric"
                                               FontSize="12"
                                               HorizontalTextAlignment="End" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 3. Aluguel Mensal -->
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*, Auto, 110" ColumnSpacing="10" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Aluguel Mensal"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A" />
                                        <Label Text="Assinatura por 30 dias"
                                               FontSize="10"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1"
                                            IsToggled="{Binding PermiteMensal}"
                                            OnColor="#16A34A"
                                            ThumbColor="#FFFFFF"
                                            VerticalOptions="Center" />
                                    <Border Grid.Column="2"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#F8FAFC"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,2"
                                            IsEnabled="{Binding PermiteMensal}">
                                        <Entry Text="{Binding ValorMensal}"
                                               Placeholder="450.00"
                                               TextColor="#0F172A"
                                               Keyboard="Numeric"
                                               FontSize="12"
                                               HorizontalTextAlignment="End" />
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Seleção e URL da Imagem (ImageService) -->
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xf03e;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <Label Text="Foto / Imagem do Console"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </HorizontalStackLayout>

                        <!-- Botão de Selecionar Imagem no Computador / Celular -->
                        <Button Text="Escolher Imagem do Dispositivo"
                                Command="{Binding SelecionarImagemConsoleCommand}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#0F172A"
                                BorderColor="#CBD5E1"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="40" />

                        <!-- Campo para digitar URL se preferir -->
                        <Border Stroke="#CBD5E1"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,2">
                            <Entry Text="{Binding ImgDiretorio}"
                                   Placeholder="Ou digite a URL da imagem (https://...)"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#0F172A"
                                   FontSize="12" />
                        </Border>

                        <!-- Miniatura Preview da Imagem Selecionada -->
                        <Border Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 8"
                                HeightRequest="120"
                                Padding="4">
                            <Image Source="{Binding ImgDiretorio}"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Descrição dos Acessórios -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Descrição dos Acessórios e Jogos"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#334155" />
                        <Border Stroke="#CBD5E1"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,4">
                            <Editor Text="{Binding Desc}"
                                    Placeholder="ex: Acompanha 2 controles sem fio, cabos e 5 jogos instalados."
                                    PlaceholderColor="#94A3B8"
                                    TextColor="#0F172A"
                                    HeightRequest="80" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botões de Ação com FontAwesome Solid -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                        <!-- Salvar -->
                        <Button Grid.Column="0"
                                Text="{Binding TextoBotaoSalvar}"
                                Command="{Binding SalvarItemCommand}"
                                BackgroundColor="#16A34A"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="8"
                                HeightRequest="46" />

                        <!-- Voltar / Cancelar -->
                        <Button Grid.Column="1"
                                Text="Voltar"
                                Command="{Binding VoltarCommand}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#475569"
                                BorderColor="#CBD5E1"
                                BorderWidth="1"
                                FontSize="13"
                                CornerRadius="8"
                                HeightRequest="46" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>
