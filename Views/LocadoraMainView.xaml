<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjetoFinalMVVM.ViewModels"
             xmlns:models="clr-namespace:ProjetoFinalMVVM.Models"
             x:Class="ProjetoFinalMVVM.Views.LocadoraMainView"
             x:DataType="vm:ItemViewModel"
             Title="Gestão da Unidade"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="18">

            <!-- 1. TOPO / CABEÇALHO DO GERENTE DA LOCADORA -->
            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14">
                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xf54f;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="15"
                                   TextColor="#4338CA"
                                   VerticalOptions="Center" />
                            <Label Text="Unidade:"
                                   FontSize="15"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding LocadoraNomeUsuarioLogado}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#4338CA"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Gerente:"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label Text="{Binding NomeUsuarioLogado}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#16A34A" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Botão Histórico da Loja -->
                    <Button Grid.Column="1"
                            Text="Histórico"
                            Command="{Binding IrParaHistoricoCommand}"
                            BackgroundColor="#F0F9FF"
                            TextColor="#0284C7"
                            BorderColor="#BAE6FD"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="10,0" />

                    <!-- Botão Ajustes -->
                    <Button Grid.Column="2"
                            Text="Ajustes"
                            Command="{Binding IrParaConfiguracoesCommand}"
                            BackgroundColor="#F8FAFC"
                            TextColor="#475569"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="10,0" />

                    <!-- Botão Sair -->
                    <Button Grid.Column="3"
                            Text="Sair"
                            Command="{Binding DeslogarCommand}"
                            BackgroundColor="#FEE2E2"
                            TextColor="#DC2626"
                            BorderColor="#FCA5A5"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="10,0" />
                </Grid>
            </Border>

            <!-- 2. DASHBOARD DA UNIDADE -->
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="&#xf201;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="16"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                    <Label Text="Dashboard Operacional da Unidade"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10" ColumnSpacing="10">

                    <!-- Card Receita da Unidade -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Stroke="#BBF7D0"
                            StrokeThickness="1"
                            BackgroundColor="#F0FDF4"
                            StrokeShape="RoundRectangle 14"
                            Padding="14">
                        <VerticalStackLayout Spacing="3">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="&#xf155;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="11"
                                       TextColor="#15803D"
                                       VerticalOptions="Center" />
                                <Label Text="FATURAMENTO"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#15803D" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding ReceitaUnidadeFormatada}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#16A34A" />
                            <Label Text="Total gerado nesta filial"
                                   FontSize="11"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card Locações Ativas da Unidade -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="#BAE6FD"
                            StrokeThickness="1"
                            BackgroundColor="#F0F9FF"
                            StrokeShape="RoundRectangle 14"
                            Padding="14">
                        <VerticalStackLayout Spacing="3">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="&#xf1da;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="11"
                                       TextColor="#0369A1"
                                       VerticalOptions="Center" />
                                <Label Text="LOCAÇÕES ATIVAS"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#0369A1" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding LocacoesAtivasUnidadeCount, StringFormat='{0} em andamento'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0284C7" />
                            <Label Text="Aparelhos com clientes"
                                   FontSize="11"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card Consoles da Unidade -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                            Stroke="#FDE68A"
                            StrokeThickness="1"
                            BackgroundColor="#FFFBEB"
                            StrokeShape="RoundRectangle 14"
                            Padding="14">
                        <Grid ColumnDefinitions="*, *" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="&#xf468;"
                                           FontFamily="FontAwesomeSolid"
                                           FontSize="11"
                                           TextColor="#B45309"
                                           VerticalOptions="Center" />
                                    <Label Text="ESTOQUE DESTA FILIAL"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#B45309" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding ConsolesDisponiveisUnidadeCount, StringFormat='{0} Livres'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#16A34A" />
                                    <Label Text="|" TextColor="#CBD5E1" />
                                    <Label Text="{Binding ConsolesAlugadosUnidadeCount, StringFormat='{0} Alugados'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#DC2626" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Botão Adicionar Console -->
                            <Button Grid.Column="1"
                                    Text="+ Novo Console"
                                    Command="{Binding IrParaNovoConsoleCommand}"
                                    BackgroundColor="#16A34A"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="38"
                                    HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- 3. RETIRADAS PENDENTES DE VALIDAÇÃO (PIN DE 6 DÍGITOS) -->
            <Border Stroke="#BAE6FD"
                    StrokeThickness="1.5"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="&#xf023;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="16"
                                   TextColor="#0284C7"
                                   VerticalOptions="Center" />
                            <Label Text="Validação de Retiradas Pendentes"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Border BackgroundColor="#E0F2FE"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="8,2"
                                    VerticalOptions="Center">
                                <Label Text="{Binding LocacoesPendentesCount, StringFormat='{0} pendente(s)'}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#0369A1" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <Label Text="Digite o código PIN de 6 dígitos informado pelo cliente no balcão para liberar a retirada do console:"
                           FontSize="11"
                           TextColor="#64748B" />

                    <!-- Lista de Locações Aguardando Retirada -->
                    <CollectionView ItemsSource="{Binding LocacoesPendentesRetirada}">
                        <CollectionView.EmptyView>
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#F8FAFC"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="14">
                                <Label Text="Nenhuma locação aguardando retirada nesta filial no momento."
                                       FontSize="12"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Locacao">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="10">
                                        <!-- Topo do Card: Console e Status -->
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding ItemNome}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A" />
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding ChaveSerialConsole, StringFormat='Serial: {0}'}"
                                                           FontSize="11"
                                                           TextColor="#64748B" />
                                                    <Label Text="•" TextColor="#CBD5E1" />
                                                    <Label Text="{Binding ModalidadeAluguel, StringFormat='Plano: {0}'}"
                                                           FontSize="11"
                                                           TextColor="#64748B" />
                                                    <Label Text="•" TextColor="#CBD5E1" />
                                                    <Label Text="{Binding ValorTotalFormatado}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="#16A34A" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Badge de Aguardando Retirada -->
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding StatusBadgeBg}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="8,3">
                                                <Label Text="{Binding StatusTexto}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding StatusBadgeText}" />
                                            </Border>
                                        </Grid>

                                        <!-- Informações do Cliente e Data da Reserva -->
                                        <Border BackgroundColor="#F8FAFC"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,8">
                                            <Grid ColumnDefinitions="*, *" RowSpacing="2">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="CLIENTE"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="#94A3B8" />
                                                    <Label Text="{Binding UsuarioNome}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#0F172A" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                    <Label Text="RESERVADO EM"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="#94A3B8" />
                                                    <Label Text="{Binding DataLocacaoFormatada}"
                                                           FontSize="11"
                                                           TextColor="#64748B" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>

                                        <!-- Campo de Entrada do PIN de 6 Dígitos e Botão Validar -->
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <Border Grid.Column="0"
                                                    Stroke="#CBD5E1"
                                                    StrokeThickness="1"
                                                    BackgroundColor="#FFFFFF"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="10,0">
                                                <Entry Text="{Binding CodigoDigitado}"
                                                       Placeholder="PIN de 6 dígitos"
                                                       MaxLength="6"
                                                       Keyboard="Numeric"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <Button Grid.Column="1"
                                                    Text="Confirmar Retirada"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ValidarCodigoRetiradaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#16A34A"
                                                    TextColor="#FFFFFF"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    CornerRadius="8"
                                                    HeightRequest="42"
                                                    Padding="14,0" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 4. CALENDÁRIO DE DEVOLUÇÕES DA UNIDADE (14 DIAS) -->
            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="&#xf133;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="16"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                        <Label Text="Devoluções Agendadas para Esta Unidade"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />
                        <Label Text="(Próximos 14 Dias)"
                               FontSize="12"
                               TextColor="#94A3B8"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Carrossel de Dias do Calendário -->
                    <CollectionView ItemsSource="{Binding DiasCalendario}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelecionadoDia, Mode=TwoWay}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiaCalendario">
                                <Border Stroke="{Binding CorBordaCard}"
                                        StrokeThickness="1.5"
                                        BackgroundColor="{Binding CorFundoCard}"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="66"
                                        HeightRequest="88"
                                        Padding="4">
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                        <Label Text="{Binding DiaSemana}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#64748B"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding DiaNumero}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               HorizontalTextAlignment="Center" />
                                        <Border BackgroundColor="{Binding CorBadgeFundo}"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="4,1"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding TemDevolucoes}">
                                            <Label Text="{Binding QuantidadeDevolucoes, StringFormat='{0} dev.'}"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding CorTextoBadge}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Lista de Devoluções do Dia Selecionado -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Entregas Previstas para a Data Selecionada:"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#334155" />

                        <CollectionView ItemsSource="{Binding DevolucoesDoDia}">
                            <CollectionView.EmptyView>
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14">
                                    <Label Text="Nenhuma devolução prevista para esta unidade neste dia."
                                           FontSize="12"
                                           TextColor="#64748B"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Historico">
                                    <Border Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            BackgroundColor="#FFFFFF"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding ItemNome}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A" />
                                                <Label Text="{Binding ChaveSerialConsole, StringFormat='Serial: {0}'}"
                                                       FontSize="11"
                                                       TextColor="#64748B" />
                                                <Label Text="{Binding UsuarioNome, StringFormat='Cliente: {0}'}"
                                                       FontSize="11"
                                                       TextColor="#16A34A" />
                                            </VerticalStackLayout>

                                            <!-- Ação de Dar Baixa no Aluguel -->
                                            <Button Grid.Column="1"
                                                    Text="Receber Console"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ReceberConsoleCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#16A34A"
                                                    TextColor="#FFFFFF"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    CornerRadius="6"
                                                    HeightRequest="34" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. CATÁLOGO DE CONSOLES DESTA UNIDADE -->
            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="&#xf468;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="16"
                                   TextColor="#16A34A"
                                   VerticalOptions="Center" />
                            <Label Text="Consoles Cadastrados Nesta Unidade"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="+ Adicionar Console"
                                Command="{Binding IrParaNovoConsoleCommand}"
                                BackgroundColor="#F0FDF4"
                                TextColor="#16A34A"
                                BorderColor="#BBF7D0"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="11"
                                CornerRadius="8"
                                HeightRequest="34" />
                    </Grid>

                    <!-- Lista de Consoles da Unidade -->
                    <CollectionView ItemsSource="{Binding ItensDaUnidade}">
                        <CollectionView.EmptyView>
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#F8FAFC"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="20">
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="Nenhum console cadastrado nesta unidade ainda."
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#64748B"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Clique em '+ Adicionar Console' para incluir aparelhos no estoque da sua loja."
                                           FontSize="11"
                                           TextColor="#94A3B8"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Item">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="90, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <!-- Imagem -->
                                        <Border Grid.Column="0"
                                                HeightRequest="75"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#F1F5F9">
                                            <Image Source="{Binding ImgDiretorio}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- Informações -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Nome}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A" />
                                            <Label Text="{Binding ChaveSerial, StringFormat='Serial: {0}'}"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding ValorDiariaFormatado}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#16A34A" />
                                                <Label Text="•" TextColor="#CBD5E1" />
                                                <Border BackgroundColor="{Binding StatusBadgeBg}"
                                                        StrokeShape="RoundRectangle 4"
                                                        Padding="6,1">
                                                    <Label Text="{Binding Status}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding StatusBadgeText}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Ações: Editar e Excluir -->
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Button Text="Editar"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=EditarItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F1F5F9"
                                                    TextColor="#475569"
                                                    FontSize="11"
                                                    CornerRadius="6"
                                                    HeightRequest="32"
                                                    Padding="10,0" />

                                            <Button Text="Excluir"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ExcluirItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2"
                                                    TextColor="#DC2626"
                                                    FontSize="11"
                                                    CornerRadius="6"
                                                    HeightRequest="32"
                                                    Padding="10,0" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 5. GESTÃO DE SERVIÇOS OPCIONAIS DA UNIDADE -->
            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="&#xf7a9;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="16"
                                   TextColor="#7E22CE"
                                   VerticalOptions="Center" />
                            <Label Text="Serviços Opcionais da Unidade"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Border BackgroundColor="#F3E8FF"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="8,2"
                                    VerticalOptions="Center">
                                <Label Text="{Binding ServicosOpcionaisCount, StringFormat='{0} cadastrado(s)'}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#7E22CE" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Botão Adicionar Serviço -->
                        <Button Grid.Column="1"
                                Text="+ Novo Serviço"
                                Command="{Binding AbrirFormularioNovoServicoCommand}"
                                BackgroundColor="#FAF5FF"
                                TextColor="#7E22CE"
                                BorderColor="#E9D5FF"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="11"
                                CornerRadius="8"
                                HeightRequest="34" />
                    </Grid>

                    <Label Text="Cadastre acessórios extras, periféricos ou serviços adicionais (ex: controles, headsets, seguros) que aparecerão no checkout de aluguel desta locadora:"
                           FontSize="11"
                           TextColor="#64748B" />

                    <!-- FORMULÁRIO COLAPSÁVEL DE NOVO SERVIÇO -->
                    <Border IsVisible="{Binding IsFormularioNovoServicoVisivel}"
                            Stroke="#D8B4FE"
                            StrokeThickness="1.5"
                            BackgroundColor="#FAF5FF"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Cadastrar Novo Serviço ou Acessório"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#6B21A8" />

                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, 120" RowSpacing="8" ColumnSpacing="10">
                                <!-- Nome do Serviço -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                    <Label Text="Nome do Serviço / Acessório *"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#475569" />
                                    <Border Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#FFFFFF"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,0">
                                        <Entry Text="{Binding NovoServicoNome}"
                                               Placeholder="Ex: Controle Extra DualSense"
                                               FontSize="12"
                                               TextColor="#0F172A"
                                               HeightRequest="38" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Valor do Serviço -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                    <Label Text="Valor (R$) *"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#475569" />
                                    <Border Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#FFFFFF"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,0">
                                        <Entry Text="{Binding NovoServicoValorTexto}"
                                               Placeholder="25,00"
                                               Keyboard="Numeric"
                                               FontSize="12"
                                               TextColor="#0F172A"
                                               HeightRequest="38" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Descrição do Serviço -->
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                                    <Label Text="Descrição / Benefício"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#475569" />
                                    <Border Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#FFFFFF"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,0">
                                        <Entry Text="{Binding NovoServicoDescricao}"
                                               Placeholder="Ex: Controle adicional original para multiplayer"
                                               FontSize="12"
                                               TextColor="#0F172A"
                                               HeightRequest="38" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Botões de Ação do Formulário -->
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,4,0,0">
                                <Button Text="Cancelar"
                                        Command="{Binding FecharFormularioNovoServicoCommand}"
                                        BackgroundColor="#FFFFFF"
                                        TextColor="#64748B"
                                        BorderColor="#CBD5E1"
                                        BorderWidth="1"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="6"
                                        HeightRequest="34"
                                        Padding="12,0" />

                                <Button Text="Salvar Serviço"
                                        Command="{Binding SalvarNovoServicoOpcionalCommand}"
                                        BackgroundColor="#7E22CE"
                                        TextColor="#FFFFFF"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="6"
                                        HeightRequest="34"
                                        Padding="14,0" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- LISTA DE SERVIÇOS OPCIONAIS CADASTRADOS NA UNIDADE -->
                    <CollectionView ItemsSource="{Binding ServicosOpcionaisDaUnidade}">
                        <CollectionView.EmptyView>
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#F8FAFC"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="Nenhum serviço adicional cadastrado nesta unidade."
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#64748B"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Clique em '+ Novo Serviço' para disponibilizar opcionais para seus clientes."
                                           FontSize="11"
                                           TextColor="#94A3B8"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ServicoOpcional">
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <!-- Ícone do Serviço -->
                                        <Border Grid.Column="0"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#F3E8FF"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding IconeGlyph}"
                                                   FontFamily="FontAwesomeSolid"
                                                   FontSize="16"
                                                   TextColor="#7E22CE"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Informações do Serviço -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding Nome}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A" />
                                                <Label Text="{Binding ValorFormatado, StringFormat='(+{0})'}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#16A34A" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Descricao}"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <!-- Badge Status (Ativo / Pausado) com Toggle -->
                                        <Border Grid.Column="2"
                                                BackgroundColor="{Binding StatusBadgeBg}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="8,4"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=AlternarAtivoServicoOpcionalCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding StatusTexto}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding StatusCor}" />
                                                <Label Text="&#xf021;"
                                                       FontFamily="FontAwesomeSolid"
                                                       FontSize="9"
                                                       TextColor="{Binding StatusCor}" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- Botão Excluir -->
                                        <Button Grid.Column="3"
                                                Text="&#xf2ed;"
                                                FontFamily="FontAwesomeSolid"
                                                FontSize="13"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemViewModel}}, Path=ExcluirServicoOpcionalCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FEE2E2"
                                                TextColor="#DC2626"
                                                CornerRadius="6"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                Padding="0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
